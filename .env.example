# Google Apps Script web-app URL for registration submissions.
# Create an Apps Script bound to a Google Sheet (see README), deploy it as a Web App,
# and paste the resulting /exec URL here.
GOOGLE_SHEETS_WEBAPP_URL=

# Optional shared secret for the Apps Script. The Next.js API route sends this in
# the payload; reject submissions in your Apps Script that don't match.
REGISTRATION_SHARED_SECRET=change-me-to-a-long-random-string
